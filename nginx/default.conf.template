server {
  listen 80;
  server_name _;
  client_max_body_size 50M;

  # API proxy - must come BEFORE the catch-all location.
  # API_HOST is resolved at container start from the environment:
  #   - docker-compose : "api" (default set in the Dockerfile)
  #   - Railway        : <api-service-name>.railway.internal
  location /api/ {
    proxy_pass http://${API_HOST}:4000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    client_max_body_size 50M;
  }

  # Frontend - catch-all for SPA
  location / {
    root /usr/share/nginx/html;
    try_files $uri $uri/ /index.html;
    index index.html;
  }
}
