server {
  listen 80;
  server_name _;
  client_max_body_size 50M;

  # DNS resolver used for RUNTIME lookups. nginx re-resolves every 10s so a
  # redeployment of the API (new private IP) never leaves nginx pointing at a
  # stale address (fixes intermittent 502/timeout on /api/*):
  #   - docker-compose : Docker's embedded DNS 127.0.0.11 (default in Dockerfile)
  #   - Railway        : Railway's private DNS fd12::10 (set via service env)
  resolver ${NGINX_RESOLVER} valid=10s;
  resolver_timeout 5s;

  # API proxy - must come BEFORE the catch-all location.
  # proxy_pass uses a VARIABLE so nginx resolves API_HOST at request time via
  # the resolver above, instead of caching the IP once at startup.
  # API_HOST comes from the environment:
  #   - docker-compose : "api" (default set in the Dockerfile)
  #   - Railway        : <api-service-name>.railway.internal
  set $api_upstream http://${API_HOST}:4000;

  location /api/ {
    proxy_pass $api_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    client_max_body_size 50M;
  }

  # Frontend - catch-all for SPA
  location / {
    root /usr/share/nginx/html;
    try_files $uri $uri/ /index.html;
    index index.html;
  }
}
